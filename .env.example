# --- Required ----------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# --- Storage (defaults are fine locally; point at a volume in production) ----
DATA_DIR=data
# CHROMA_PATH=data/chroma
# DATABASE_PATH=data/examforge.db

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://exam-forge-ai.vercel.app
# Regex that also allows Vercel preview deployments.
CORS_ORIGIN_REGEX=https://exam-forge-ai.*\.vercel\.app

# --- Models (optional overrides) --------------------------------------------
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# UTILITY_MODEL=llama-3.1-8b-instant
# GENERATION_MODEL=openai/gpt-oss-120b

# --- Retrieval tuning (optional) --------------------------------------------
# RETRIEVER_K=5
# RERANK_TOP_N=5
# MIN_RELEVANCE_SCORE=0.05
# MEMORY_WINDOW=6
# CHUNK_SIZE=512
# CHUNK_OVERLAP=50
# MAX_UPLOAD_MB=10
